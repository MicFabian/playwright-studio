{
  "name": "playwright-lowcode-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "node scripts/build-flow-core.mjs && node scripts/build-flow-import.mjs && tsc --noEmit && vite build",
    "preview": "node server.mjs --prod",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "vite-node scripts/migrate-workspace.ts",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder",
    "desktop:dir": "npm run build && electron-builder --dir",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-morph": "^24.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.1",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "dev.playwrightstudio.app",
    "productName": "Playwright Studio",
    "files": [
      "electron/**",
      "server/**",
      "server.mjs",
      "dist/**",
      "packages/*/dist/**",
      "packages/studio-runner/src/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "node_modules/@playwright/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**",
      "packages/studio-runner/src/**"
    ],
    "afterSign": "scripts/notarize.cjs"
  },
  "description": "A low-code editor for Playwright tests that compiles to real, committable specs.",
  "author": {
    "name": "MicFabian"
  }
}
