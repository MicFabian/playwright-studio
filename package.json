{
  "name": "playwright-lowcode-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node server.mjs --prod",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "vite-node scripts/migrate-workspace.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
