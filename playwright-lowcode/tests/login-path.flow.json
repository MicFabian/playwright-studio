  "root": {
    "steps": [
      {
        "id": "node-open-login",
        "label": "Open local page",
        "kind": "navigate",
        "url": {
          "source": "literal",
          "value": "about:blank"
        }
      },
      {
        "id": "node-load-login-fixture",
        "label": "Load login fixture",
        "kind": "code",
        "code": "await page.setContent(`\n<main>\n  <label>Email <input name='email' /></label>\n  <label>Password <input name='password' type='password' /></label>\n  <button data-testid='submit-login'>Sign in</button>\n  <h1 data-testid='dashboard-title'>Signed out</h1>\n</main>\n<script>\n  const email = document.querySelector('[name=\"email\"]');\n  const password = document.querySelector('[name=\"password\"]');\n  const submit = document.querySelector('[data-testid=\"submit-login\"]');\n  const title = document.querySelector('[data-testid=\"dashboard-title\"]');\n  submit.addEventListener('click', () => {\n    title.textContent = email.value && password.value ? 'Dashboard' : 'Signed out';\n  });\n</script>\n`);"
      },
      {
        "id": "node-fill-email",
        "label": "Fill email",
        "kind": "fill",
        "target": {
          "base": {
            "by": "css",
            "selector": {
              "source": "literal",
              "value": "[name=\"email\"]"
            }
          }
        },
        "value": {
          "source": "literal",
          "value": "qa@example.com"
        }
      },
      {
        "id": "node-fill-password",
        "label": "Fill password",
        "kind": "fill",
        "target": {
          "base": {
