          "value": "super-secret-password"
        }
      },
      {
        "id": "node-submit-login",
        "label": "Submit login",
        "kind": "click",
        "target": {
          "base": {
            "by": "testId",
            "value": {
              "source": "literal",
              "value": "submit-login"
            }
          }
        }
      },
      {
        "id": "node-dashboard-loads",
