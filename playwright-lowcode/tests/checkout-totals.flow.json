{
  "formatVersion": 2,
  "id": "checkout-totals",
  "name": "Checkout totals",
  "status": "stable",
  "updatedAt": "2026-08-22T18:53:00.262Z",
  "root": {
    "steps": [
      {
        "id": "node-open-checkout",
        "label": "Open local page",
        "kind": "navigate",
        "url": {
          "source": "literal",
          "value": "about:blank"
        }
      },
      {
        "id": "node-load-checkout-fixture",
        "label": "Load checkout fixture",
        "kind": "code",
        "code": "await page.setContent(`\n<main>\n  <h1>Checkout</h1>\n  <label>Coupon <input name='coupon' /></label>\n  <button data-testid='apply-coupon'>Apply</button>\n  <p data-testid='order-total'>$100.00</p>\n</main>\n<script>\n  const input = document.querySelector('[name=\"coupon\"]');\n  const button = document.querySelector('[data-testid=\"apply-coupon\"]');\n  const total = document.querySelector('[data-testid=\"order-total\"]');\n  button.addEventListener('click', () => {\n    total.textContent = input.value === 'SPRING25' ? '$75.00' : '$100.00';\n  });\n</script>\n`);"
      },
      {
        "id": "node-fill-coupon",
        "label": "Fill coupon",
        "kind": "fill",
        "target": {
          "base": {
            "by": "css",
            "selector": {
              "source": "literal",
              "value": "[name=\"coupon\"]"
            }
          }
        },
        "value": {
          "source": "literal",
          "value": "SPRING25"
        }
      },
      {
        "id": "node-apply-coupon",
        "label": "Apply coupon",
        "kind": "click",
        "target": {
          "base": {
            "by": "testId",
            "value": {
              "source": "literal",
              "value": "apply-coupon"
            }
          }
        }
      },
      {
        "id": "node-assert-total",
        "label": "Discounted total appears",
        "kind": "assert",
        "target": {
          "base": {
            "by": "testId",
            "value": {
              "source": "literal",
              "value": "order-total"
            }
          }
        },
        "assertion": {
          "type": "containsText",
          "text": {
            "source": "literal",
            "value": "$75.00"
          }
        }
      }
    ]
  },
